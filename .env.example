# =============================================================================
#  Configurações do Kali Linux Sandbox (copie para .env e ajuste)
#  cp .env.example .env
# =============================================================================

# --- Conjunto de ferramentas Kali -------------------------------------------
# kali-tools-top10    -> ~600 pacotes (nmap, metasploit, wireshark, burp...)
# kali-linux-headless -> conjunto headless completo (~1300 pacotes)
# kali-linux-large    -> praticamente tudo (~2100 pacotes)
# (vazio)             -> sem ferramentas extras (imagem leve)
KALI_TOOLS=kali-tools-top10

# --- Usuário -----------------------------------------------------------------
USERNAME=kali

# --- Desktop / VNC -----------------------------------------------------------
VNC_PW=kali
VNC_GEOMETRY=1440x900
VNC_DEPTH=24
VNC_PORT=5901
NOVNC_PORT=6080

# --- Localização -------------------------------------------------------------
TZ=America/Sao_Paulo
